{
  "name": "kerjaku-api",
  "version": "1.0.0",
  "private": true,
  "description": "REST API KerjaKu (Node.js + Express + SQLite)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "static": "node build-static.js",
    "reset": "node -e \"require('fs').rmSync('data/kerjaku.db', { force: true }); console.log('Database dihapus. Jalankan server untuk membuat ulang data awal.')\""
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "sqlite3": "^6.0.1"
  },
  "allowScripts": {
    "sqlite3@6.0.1": true
  }
}
